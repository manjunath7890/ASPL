# ──────────────────────────────────────────────────────────────────────────────
# Environment Variables — copy to .env and fill in your values
# NEVER commit .env to git
# ──────────────────────────────────────────────────────────────────────────────

# ── MongoDB Atlas ─────────────────────────────────────────────────────────────
# Get from: Atlas Console → Connect → Drivers → copy URI
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/iot?retryWrites=true&w=majority

# ── EMQX Cloud Webhook ────────────────────────────────────────────────────────
# A shared secret between your Vercel app and EMQX Cloud.
# Set the SAME value in EMQX → Data Integration → HTTP Server → Headers:
#   x-webhook-secret: <value>
EMQX_WEBHOOK_SECRET=my_super_secret_123

# ── Upstash Redis (SSE real-time stream + heartbeat) ─────────────────────────
# Get from: console.upstash.com → your DB → REST API tab
UPSTASH_REDIS_REST_URL=https://xxxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=AXxxxxxxxxxxxx

# ── Gmail / Nodemailer (OTP emails) ───────────────────────────────────────────
GMAIL_USER=your@gmail.com
# Generate at: Google Account → Security → App Passwords
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# ── Auth / Security ───────────────────────────────────────────────────────────
CRYPTO_KEY=telematics_secure_local_storage_key
OTP_EXPIRY_MINUTES=5

# ── CORS (optional — restrict to your Vercel domain) ─────────────────────────
# Leave empty or set to * to allow all origins (default)
# Set to your deployed URL to restrict: https://your-app.vercel.app
ALLOWED_ORIGIN=*

# ── Server (local dev only — Vercel sets PORT automatically) ─────────────────
PORT=3000