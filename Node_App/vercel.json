{
  "version": 2,
  "builds": [
    {
      "src": "index.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["build/**", "model/**", "routes/**", "router/**", "lib/**", "db doc/**"]
      }
    }
  ],
  "routes": [
    { "src": "/(.*)", "dest": "index.js" }
  ],
  "crons": [
    {
      "path": "/api/analytics/cron-daily",
      "schedule": "29 18 * * *"
    }
  ]
}
